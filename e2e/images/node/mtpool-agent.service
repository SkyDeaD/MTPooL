[Unit]
Description=MTPooL node agent
After=network-online.target telemt.service

[Service]
# Plain http to the registrar and private addresses are for the stand only.
Environment=MTPOOL_ALLOW_PRIVATE_IPS=true
Environment=MTPOOL_GLOBALPING_URL=http://fakes:9000/globalping/
Environment=MTPOOL_IP_SOURCES=http://fakes:9000/ip,http://fakes:9000/ip?2,http://fakes:9000/ip?3,http://fakes:9000/ip?4
Environment=MTPOOL_IPSUM_URL=http://fakes:9000/ipsum
ExecStart=/usr/local/bin/mtpool-agent run
Restart=on-failure
RestartSec=1
